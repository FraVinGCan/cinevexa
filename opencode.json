{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".agents/rules/**/*.md"
  ],
  "mcp": {
    "react-docs": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "react-docs-mcp"
      ]
    },
    "shadcn": {
      "type": "local",
      "command": [
        "npx",
        "shadcn@latest",
        "mcp"
      ],
      "enabled": true
    }
  }
}
